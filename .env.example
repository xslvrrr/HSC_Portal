# Existing server-side AI key used only by Vercel functions. Do not expose it as a VITE_ variable.
OPENROUTER_API_KEY=

# A Firebase service-account JSON object for the HSC Portal Firebase project.
# Store the complete JSON as one protected Vercel environment variable; never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional. This is the dedicated portal Firestore default database used when no override is supplied.
FIREBASE_FIRESTORE_DATABASE_ID=(default)

# Optional model override for structured paper analysis.
PAPER_METADATA_MODEL=openrouter/free
